rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified @databeat.io Google account.
    function inDomain() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@databeat[.]io');
    }

    // Admins are listed (lower-case) in the document config/admins, field "emails".
    function isAdmin() {
      return inDomain()
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // Each person reads and writes their own profile. Admins can read every profile (for reports) and reset one.
    // A player's profile must carry their own sign-in email, so nobody can appear as someone else in reports.
    match /users/{uid} {
      allow read, delete: if inDomain() && request.auth.uid == uid;
      allow create, update: if inDomain() && request.auth.uid == uid
        && request.resource.data.get('email', request.auth.token.email) == request.auth.token.email;
      allow read, update: if isAdmin();
    }

    // Everyone in the domain reads settings, announcements and the admin list. Only admins change them,
    // and the admin list can never be emptied from the app.
    match /config/{doc} {
      allow read: if inDomain();
      allow write: if isAdmin()
        && (doc != 'admins' || (request.resource.data.emails is list && request.resource.data.emails.size() >= 1));
    }

    match /packs/{game} {
      allow read: if inDomain();
      allow write: if isAdmin();
      match /versions/{v} {
        allow read, write: if isAdmin();
      }
    }

    // One document per reported question. People can add their own report once; only admins read, close or delete them.
    // Each report adds the reporter's own entry, raises the count by 1 and raises their chosen reason by 1.
    function myReason() { return request.resource.data.reporters[request.auth.uid].reason; }
    match /reports/{rid} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create: if inDomain()
        && request.resource.data.keys().hasOnly(['game', 'itemId', 'count', 'reporters', 'reasons', 'preview', 'createdAt'])
        && request.resource.data.count == 1
        && request.resource.data.reporters.keys().hasOnly([request.auth.uid])
        && request.auth.uid in request.resource.data.reporters
        && request.resource.data.reasons.keys().hasOnly([myReason()])
        && request.resource.data.reasons[myReason()] == 1
        && request.resource.data.preview.size() <= 200;
      allow update: if isAdmin()
        || (inDomain()
          && !(request.auth.uid in resource.data.reporters)
          && request.auth.uid in request.resource.data.reporters
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'reporters', 'reasons'])
          && request.resource.data.reporters.diff(resource.data.reporters).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.reasons.diff(resource.data.reasons).affectedKeys().hasOnly([myReason()])
          && request.resource.data.reasons[myReason()] == resource.data.reasons.get(myReason(), 0) + 1);
    }

    // History of closed reports, kept for the export. Admins only.
    match /reportlog/{id} {
      allow read, write: if isAdmin();
    }

    // Help and feedback. Anyone in the domain can send their own; only admins read, update or delete.
    match /feedback/{id} {
      allow create: if inDomain()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['problem', 'idea', 'question']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.get('email', request.auth.token.email) == request.auth.token.email
        && request.resource.data.get('status', 'open') == 'open';
      allow read, update, delete: if isAdmin();
    }

    // Floor goal: one counter per week. Anyone in the domain can add exactly 1 at a time. No names are stored.
    match /floor/{week} {
      allow read: if inDomain();
      allow create: if inDomain()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if inDomain()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // Right and wrong tallies per question (no names). Everyone adds to them after a round; only admins read them.
    match /qstats/{game} {
      allow read: if isAdmin();
      allow create: if inDomain();
      allow update: if inDomain()
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 12;
    }
  }
}
